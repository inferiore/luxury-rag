# --- Postgres ---
# El significado de estos 6 valores depende de qué compose stack los usa:
#
# - Dev (docker-compose.dev.yml, self-hosted Postgres en un contenedor local):
#   POSTGRES_HOST/PORT/SSL se hardcodean a postgres:5432/false directamente
#   en docker-compose.dev.yml y los valores de este archivo se IGNORAN para
#   ese caso. Solo USER/PASSWORD/DB de este archivo se usan (para levantar
#   el contenedor local con esas credenciales). Los valores de abajo
#   (localhost:5432) son los correctos si en vez de Docker corres el backend
#   directamente en el host (`npm run start:dev`) apuntando al Postgres
#   dockerizado, que publica su puerto en localhost.
#
# - Producción (docker-compose.yml, Supabase Postgres administrado, conexión
#   directa sin pooler): este compose YA NO levanta ningún Postgres local —
#   los 6 valores se LEEN de este archivo (vía `.env` real, no este ejemplo)
#   y deben apuntar a las credenciales reales del proyecto Supabase:
#     POSTGRES_HOST=db.<project-ref>.supabase.co
#     POSTGRES_PORT=<puerto de "Direct connection" en el dashboard de Supabase>
#     POSTGRES_USER=<usuario del proyecto>
#     POSTGRES_PASSWORD=<password del proyecto>
#     POSTGRES_DB=<nombre de la base, normalmente "postgres">
#     POSTGRES_SSL=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_db
POSTGRES_SSL=false

# --- Selección de proveedor LLM ---
# Controla qué implementación maneja TANTO embed() como chat() — no hay
# selección independiente por capacidad. "ollama" (default) corre 100%
# local. "openai" activa un cliente HTTP genérico compatible con la API de
# OpenAI: sirve para OpenRouter, Groq, Google Gemini
# (https://generativelanguage.googleapis.com/v1beta/openai), Together, LM
# Studio o la propia OpenAI, según BASE_URL. Nota: no todos los proveedores
# compatibles exponen ambos endpoints (ej. OpenRouter no tiene /embeddings)
# — si eliges "openai" necesitas un proveedor que soporte
# /chat/completions y /embeddings.
LLM_PROVIDER=ollama

# BASE_URL/CHAT_MODEL/EMBEDDING_MODEL/LLM_API_KEY son compartidos por
# AMBOS providers — solo corre uno a la vez según LLM_PROVIDER de arriba,
# así que no hace falta un nombre de variable distinto por proveedor. Si
# alternas LLM_PROVIDER en el mismo .env, tienes que actualizar estos 4
# valores para el proveedor nuevo (no quedan guardados en paralelo).
#
# Local (Ollama corriendo directo en el host, `npm run start:dev`):
#   BASE_URL=http://localhost:11434
# Ollama dentro de Docker (el contenedor debe alcanzar Ollama en el host):
#   BASE_URL=http://host.docker.internal:11434
# Proveedor cloud (ejemplos):
#   BASE_URL=https://openrouter.ai/api/v1
#   BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Sin slash final. Debe incluir cualquier prefijo de versión que el
# proveedor requiera — se concatena literal como
# "${BASE_URL}/chat/completions" y "${BASE_URL}/embeddings", sin
# normalización.
BASE_URL=http://localhost:11434
# Vacío cuando LLM_PROVIDER=ollama (no usa auth). Requerido cuando
# LLM_PROVIDER=openai.
LLM_API_KEY=
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding
VECTOR_DIM=1536

# --- Comportamiento de /query ---
# Flujo en dos etapas: DEFAULT_TOP_K es cuántos candidatos se traen de la DB
# por similitud coseno (ORDER BY distance ASC LIMIT topK); de esos, solo los
# que individualmente caen dentro de SIMILARITY_THRESHOLD se pasan como
# contexto al chat model — no necesariamente los DEFAULT_TOP_K completos.
# Preguntas normales terminan usando 1 chunk relevante; preguntas de
# comparación/recomendación pueden usar varios, hasta DEFAULT_TOP_K.
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.4

# --- Validación de /documents/upload (spec 02 v2) ---
MAX_UPLOAD_ITEMS=2000
MAX_ITEM_DEPTH=6
MAX_ITEM_SIZE_BYTES=100000

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Nombre canónico. Usa el host de tu cluster de Langfuse Cloud
# (ej. https://cloud.langfuse.com para US/global histórico, o
# https://us.cloud.langfuse.com / https://eu.cloud.langfuse.com según
# dónde se creó tu proyecto — revisa Settings > API Keys en Langfuse).
LANGFUSE_HOST=https://cloud.langfuse.com
# Alias DEPRECADO de LANGFUSE_HOST, soportado solo por compatibilidad hacia
# atrás (spec 09). Si defines LANGFUSE_HOST, este valor se ignora. No agregar
# variables nuevas usando este nombre — usa siempre LANGFUSE_HOST.
# LANGFUSE_BASE_URL=

# --- App ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Lista de orígenes permitidos, separados por coma, sin espacios extra.
# Dev local (Vite, spec 06): http://localhost:5173
# Producción: pendiente de definir — no hay todavía spec de deployment del
# frontend ni dominio asignado. Agregar aquí el origen real (ej.
# https://rag.luxuryhorizon.lat) cuando exista, separado por coma del valor
# de dev si ambos deben convivir en el mismo .env.
CORS_ORIGINS=http://localhost:5173

# --- Perfiles de Docker Compose (solo producción) ---
# Los servicios `nginx` y `certbot` de docker-compose.yml están gateados
# detrás del profile "production" (ver docker-compose.yml) para que
# `docker compose -f docker-compose.yml -f docker-compose.dev.yml up` en
# desarrollo local NO intente levantarlos (nginx crashearía: no hay
# certificados SSL de rag.luxuryhorizon.lat en local). El `.env` REAL del
# VPS de producción debe tener esta línea descomentada para que el comando
# `docker compose up -d --build` (documentado en el README y usado por la CI)
# siga levantando nginx+certbot sin necesidad de pasar `--profile production`
# a mano. Déjala vacía/comentada en dev.
# COMPOSE_PROFILES=production

# --- Frontend (build args de Docker, NO se leen de frontend/.env.example) ---
# El build de producción del frontend corre DENTRO del Dockerfile (stage
# frontend-builder) y necesita estos dos valores como build args — el
# contexto de build de Docker es rag/, no lee frontend/.env
# automáticamente. En producción VITE_API_BASE_URL debe quedar VACÍO
# (frontend y backend comparten origen detrás de nginx, así que rutas
# relativas como fetch('/query') funcionan solas). VITE_API_KEY debe ser
# la key real del cliente demo-frontend (ver npm run seed:api-clients).
VITE_API_BASE_URL=
VITE_API_KEY=

# --- Ambiente de prueba aislado (docker-compose.test.yml) ---
# Todas las variables de esta sección son OPCIONALES y solo aplican al
# stack standalone de docker-compose.test.yml (rag-postgres-test /
# rag-app-test). Tienen defaults hardcodeados en ese archivo que ya evitan
# chocar con la DB/puerto de desarrollo (rag-postgres/rag-app), así que no
# es necesario definirlas a menos que quieras cambiar el puerto expuesto o
# las credenciales de la DB de prueba. El resto de variables (EMBEDDING_MODEL,
# CHAT_MODEL, VECTOR_DIM, DEFAULT_TOP_K, SIMILARITY_THRESHOLD, CORS_ORIGINS,
# MAX_UPLOAD_ITEMS, LLM_PROVIDER, BASE_URL, LLM_API_KEY, etc.) se reutilizan tal
# cual de las secciones de arriba —
# solo host/puerto/credenciales de la DB y el puerto de la app necesitan un
# namespace propio para no pisar los valores de dev.
# Puerto en el host para Postgres de prueba (contenedor rag-postgres-test).
TEST_POSTGRES_PORT=5433
# Puerto en el host para la app de prueba (contenedor rag-app-test).
TEST_APP_PORT=3001
TEST_POSTGRES_USER=rag_test_user
TEST_POSTGRES_PASSWORD=changeme_test
TEST_POSTGRES_DB=rag_test_db
