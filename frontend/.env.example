# URL base del backend NestJS del sistema RAG (rag/, ver rag/specs/00-arquitectura-general.md).
# El backend puede correr en un host/puerto distinto al frontend (ej. Docker en :3000).
VITE_API_BASE_URL=http://localhost:3000

# API key del cliente "demo-frontend" en el backend. Se obtiene corriendo
# `npm run seed:api-clients` en rag/ — la key se imprime una sola vez en
# consola, no se puede recuperar después (el backend solo guarda su hash).
# Queda visible en el bundle del navegador (es un demo público) — el cupo
# de uso se comparte por key entre todos los visitantes, no por IP, así que
# extraerla de devtools no permite superar el límite.
VITE_API_KEY=
